# Oracle connection (thin mode, no Instant Client needed for Oracle 12.1+)
ORACLE_USER=NSIDB
ORACLE_PASSWORD=change_me
ORACLE_CONNECT_STRING=host:1521/SERVICE_NAME

# Sequence naming used for new primary keys. {TABLE} = full table name (e.g. NSIDB_COUNTRY),
# {PK} = primary key column. If the sequence doesn't exist, the app falls back to MAX(pk)+1.
ORACLE_SEQ_PATTERN={OWNER}.{TABLE}_SEQ

# Session signing secret (>= 32 chars). Generate: openssl rand -base64 32
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Comma-separated UMS_ROLE.ROLEID values allowed to open /admin (User Management)
UMS_ADMIN_ROLE_IDS=1

# Brute-force protection
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Set to true to try every write (create/edit/reset/delete) without saving anything: each is rolled back.
DB_DRY_RUN=false
